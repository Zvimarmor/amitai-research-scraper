# Copy to .env and fill in. Never commit the real .env.
# chmod 600 .env

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

FETCH_MIN_DELAY=2.0
FETCH_MAX_DELAY=4.5
SEARCH_DELAY=3.0
SEARCH_TIMEOUT=45.0
SEARCH_BACKEND=auto
SEARCH_REGION=il-he

DB_PATH=data/research.sqlite3

API_HOST=127.0.0.1
API_PORT=8000

# Strictly enforced. Localhost dev origins are always allowed on top of these.
ALLOWED_ORIGINS=https://zvimarmor.com
# ALLOWED_ORIGIN_REGEX=https://.*--your-site\.netlify\.app

# Shared bearer token the frontend sends as `Authorization: Bearer <token>`.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Falls back to the insecure "local-dev-key" if unset.
API_AUTH_TOKEN=
